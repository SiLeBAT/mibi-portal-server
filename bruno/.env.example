# Copy this file to `.env` in the same directory and fill in the key.
#
# `.env` is gitignored. Bruno loads it into `process.env`, so requests can
# reference the key as {{process.env.MIBI_RESULTS_API_KEY}} and no secret is
# ever stored inside the collection itself.
#
# This is the same variable the import scripts and the raw curl command use,
# so there is only one secret to manage.

MIBI_RESULTS_API_KEY=
