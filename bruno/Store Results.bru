meta {
  name: Store Results
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/orders/results
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-MiBi-Api-Key: {{process.env.MIBI_RESULTS_API_KEY}}
}

body:json {
  [
    {
      "snPlXS7wIY": {
        "Citrat": "kW",
        "H2S": "-",
        "Indol": "+",
        "Lactose": "+",
        "O-AG": "166",
        "e-hly": "+",
        "eae": "-",
        "stx1": "+",
        "stx2": "-",
        "CHL": "8",
        "CIP": "0,015",
        "COL": "<=2",
        "GEN": "<=0,25"
      }
    },
    {
      "y4NvFfFNdg": {
        "Serovar": "S. Typhimurium",
        "Seroformel": "(1), 4, 12:i:1,2"
      }
    },
    {
      "y4NvFfFNdg": {
        "Serovar": "S. Brandenburg",
        "Seroformel": "4,12:i:1,2"
      }
    }
  ]
}

docs {
  Stores BfR analysis results.

  Every element of the top-level array becomes one Result row, linked to a
  Sample by its Parse objectId. Two elements may carry the same sample id -
  that is how a sample gets a second result. A JSON object keyed by sample id
  cannot express this, because duplicate keys are silently dropped when the
  file is parsed.

  The sample objectIds above are test data and will not exist in your database.
  Get real ones from POST /v2/orders/samples-with-results, whose response lists
  them as samples[].id.

  Authentication: the X-MiBi-Api-Key header, read from the MIBI_RESULTS_API_KEY
  variable in the gitignored `.env` file at the root of this collection. Copy
  `.env.example` to `.env` and fill in the key. No secret is stored in this
  collection.
}
