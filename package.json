{
  "name": "mibi-portal-server",
  "version": "6.0.0",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node ./lib/main.js",
    "start:proxy": "npx pm2 start pm2.config.js --only mibi-parse-proxy",
    "serve": "nodemon -e ts --exec \"npm run serve:pipe\"",
    "debug": "nodemon -e ts --exec \"npm run debug:pipe\"",
    "serve:pipe": "npm run build && node ./lib/main.js",
    "debug:pipe": "npm run build && node --inspect-brk ./lib/main.js",
    "cp:view": "copyfiles -u 1 ./src/**/views/**/* ./lib",
    "cp:json": "copyfiles -u 1 ./src/**/*.json ./lib",
    "cp:all": "npm run cp:view && npm run cp:json",
    "tsc": "tsc",
    "build": "npm run tsc && npm run cp:all",
    "prebuild": "npm run clean",
    "test": "jest --config=jest.config.js",
    "test:integration": "jest --config=jest-integration.config.js --verbose",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage && open coverage/lcov-report/index.html",
    "test:report": "npm test -- --reporters default jest-stare --testResultsProcessor=jest-stare && open jest-stare/index.html",
    "clean": "rimraf lib/*",
    "lint": "npx eslint .",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "prepare": "(husky -v && husky ) || echo husky not installed",
    "lint:fix": "npm run lint -- --fix"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint"
    ]
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "^26.6.1",
    "@parse/fs-files-adapter": "^3.0.0",
    "argon2": "0.44.0",
    "axios": "^1.16.0",
    "compression": "~1.8.1",
    "config": "~3.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "~2.8.5",
    "csrf-csrf": "^3.2.2",
    "express": "~5.2.1",
    "express-jwt": "^8.3.0",
    "express-session": "^1.19.0",
    "fs-readfile-promise": "~3.0.1",
    "handlebars": "~4.7.9",
    "helmet": "~5.1.1",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "~9.0.3",
    "lodash": "~4.18.1",
    "mibi-portal-server": "file:",
    "moment": "~2.29.4",
    "mongodb": "^5.1.0",
    "morgan": "~1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "8.0.7",
    "openid-client": "^5.7.1",
    "parse": "^8.6.0",
    "parse-server": "^9.8.0",
    "pm2": "~7.0.1",
    "swagger-ui-express": "~4.5.0",
    "winston": "~3.10.0"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/config": "3.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.12",
    "@types/express": "5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/fs-readfile-promise": "3.0.1",
    "@types/jest": "29.5.11",
    "@types/jsonwebtoken": "9.0.0",
    "@types/lodash": "4.17.24",
    "@types/morgan": "1.9.3",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.1",
    "@types/nodemailer": "8.0.0",
    "@types/swagger-ui-express": "4.1.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "copyfiles": "~2.4.1",
    "eslint": "^8.57.1",
    "husky": "~9.0.0",
    "jest": "~29.7.0",
    "jest-stare": "~2.5.1",
    "lint-staged": "~12.4.3",
    "mock-express-request": "0.2.2",
    "mock-express-response": "0.3.0",
    "nodemon": "~2.0.20",
    "prettier": "2.6.2",
    "rimraf": "~3.0.2",
    "ts-jest": "29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0"
  },
  "mibiConfig": {
    "lastChange": "2019-04-16 11:25:17 +0200"
  }
}
